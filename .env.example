APP_ENV=development
FLASK_APP=run.py
DATABASE_URL=sqlite:///data/cards_cache.sqlite
MAX_IMAGE_SIZE_MB=12
RECOGNITION_CONFIDENCE_THRESHOLD=0.72
RECOVERY_CONFIDENCE_THRESHOLD=0.55
MAX_CARDS_PER_IMAGE=20
DETECTION_TARGET_MAX_DIMENSION=1600
CARD_WARP_WIDTH=448
CARD_WARP_HEIGHT=624
ENABLE_DIAGNOSTIC_METRICS=false
ENABLE_RECOGNITION_CACHE=true
RECOGNITION_CACHE_TTL_SECONDS=900
RECOGNITION_CACHE_MAX_ITEMS=128
OPENCV_NUM_THREADS=0
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
OCR_GPU=false
OCR_PRELOAD=false
SCRYFALL_BASE_URL=https://api.scryfall.com
SCRYFALL_TIMEOUT_SECONDS=8
SCRYFALL_USER_AGENT=MTGMultiCardRecognitionAPI/1.0 (contact: your-email@example.com)
SCRYFALL_MIN_REQUEST_INTERVAL_SECONDS=0.1
RATELIMIT_DEFAULT=60 per minute
RATELIMIT_STORAGE_URI=memory://
